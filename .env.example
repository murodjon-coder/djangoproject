# Bu faylni .env nomi bilan nusxalang va qiymatlarni o'zgartiring:  cp .env.example .env
# .env git'ga qo'shilmaydi — unda maxfiy ma'lumotlar saqlanadi.

# Serverda False bo'lishi SHART
DJANGO_DEBUG=False

# Yangi kalit yaratish:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit-yozing

# Saytingiz domeni (vergul bilan bir nechtasi)
DJANGO_ALLOWED_HOSTS=login.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://login.pythonanywhere.com

# Media fayllarni Django bersinmi (PythonAnywhere'da False, Render'da True)
DJANGO_SERVE_MEDIA=False

# HTTP → HTTPS yo'naltirish. PythonAnywhere'da False qoldiring va Web sahifasida "Force HTTPS" ni yoqing.
DJANGO_SSL_REDIRECT=False
